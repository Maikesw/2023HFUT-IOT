.toast {
    background-color: rgba(0, 0, 0, 0.5);
    *background-color: black;
    background-color: black \0;
    color: white;
    border-radius: 5px;
    padding: 10px;
    font-size: 14px;
    position: fixed;
    min-height: 60px;
    line-height: 60px;
    min-width: 180px;
    display: none;
    z-index: 9999999
}

.toast p {
    margin: 0;
    text-align: center
}

.toast.fail p {
    background-image: url("../images/fail.png");
    background-position: left center;
    background-size: 25px 25px;
    background-repeat: no-repeat
}

.toast.success p {
    background-image: url("../images/success.png");
    background-position: left center;
    background-size: 25px 25px;
    background-repeat: no-repeat
}

.in {
    animation: In 0.3s ease-in
}

@keyframes In {
    from {
        transform: scale(0, 0);
        opacity: 0
    }
    80% {
        transform: scale(1.1, 1.1);
        opacity: 0.9
    }
    to {
        transform: scale(1, 1);
        opacity: 1
    }
}

