/*提示*/
div.code_note{ clear:both; width:95%; margin:10px auto; padding:10px 0; border:1px solid #dae7e7; background:#f3f7f7;}
dl.code_note{ clear:both;line-height:1.8em; width:95%; margin:0 auto;}
dl.code_note dt{ clear:both; font-size:14px; font-weight:bold; color:#0060d7;}
dl.code_note dd{ clear:both; text-indent:2em;}
dl.code_note dd p{ clear:both;}
dl.code_note dd p b{ font-size:14px;}
/*列表页*/
dl.code_list{ clear:both; width:90%; margin:15px auto;}
dl.code_list input.input_line{ text-align:center;}
dl.code_list dt{ clear:both; font-size:14px; font-weight:bold; line-height:2em;}
dl.code_list2 dt{ font-weight:normal;}
dl.code_list dd p label{ margin-right:30px; vertical-align:middle;}
dl.code_list dd{ padding-top:8px; clear:both; padding-left:25px; line-height:2em; font-size:14px;}
dl.code_list dd p{ clear:both;}
dl.code_list dd p span.red{ display:inline-block; font-size:12px; color:#fff; background:#ff0000; line-height:1.5em; height:1.5em; margin:10px 0; padding:0 50px 0 10px;}
dl.code_list dd ul{ clear:both;}
dl.code_list dd li{ height:32px; clear:both; margin:15px 0;}
dl.code_list dd li div{ padding:0 10px;position:relative; border:1px solid #a4c9ee; background:#f1f6fa; width:390px; height:30px; line-height:30px; clear:both;}
dl.code_list dd li samp.l{ padding-left:20px; font-size:14px;}
dl.code_list dd li.even_bj div{ border:1px solid #ffa593; background:#fcf0ee;}
span.mes_arrow_o{ display:block; position:absolute; background:url(../images/code/mes_arrow_blue.gif) no-repeat; width:10px; height:7px; line-height:7px; overflow:hidden; font-size:0; top:-7px; left:5%;}
.even_bj span.mes_arrow_o{ background:url(../images/code/mes_arrow_orange.gif) no-repeat;}
/*数值*/
font.num_text{  margin:4px 5px 0 5px; vertical-align:middle; display:block; float:left; font-size:12px; background:url(../images/code/num_text.gif) no-repeat; width:61px; height:19px; line-height:19px; overflow:hidden;}
font.num_text em{ font-style:normal; float:left;}
/*表单和按钮*/
input.num_btn,input.num_text{ vertical-align:middle; border:none; background:none;}
input.num_btn{ height:19px; line-height:19px; cursor:pointer; text-align:center; width:13px;}
input.num_text{ line-height:13px; height:13px; padding:3px 0; text-align:center; color:#666; width:34px;}
/*按钮层*/
div.code_btn{ clear:both; height:26px; margin-top:40px; line-height:26px; text-align:center; background:#f6f6f6; padding:15px 0; border-top:1px solid #ebeef2; vertical-align:middle;}
div.code_btn input{ vertical-align:middle; margin:0 4px;}
input.code_btn_1,input.code_btn_2,input.code_btn_3{ background:url(../images/code/tool_btn.gif) no-repeat;height:26px; line-height:26px; border:none; cursor:pointer; width:60px;}
input.code_btn_2{ width:84px; background-position:-64px top;}
input.code_btn_3{ background-position:right top;}
/*表单*/
.code_textarea{ vertical-align:middle; margin:0 0 0 10px; border:1px solid #aabbcc; padding:5px 5px; line-height:2em; font-size:14px; width:94%; height:30px;}
/*按钮*/
input.save_btn{ border:none; cursor:pointer; text-align:center; color:#fff; vertical-align:middle; background:url(../images/code/save_btn.png) no-repeat; width:60px; height:20px; line-height:20px;}
input.save_btn:hover{ background-position:left bottom;}
/*列表*/
ul.code_list{ clear:both; width:95%; margin:5px auto;}
ul.code_list li{ overflow:hidden; zoom:1; border-bottom:1px solid #d5d5d5; padding:15px 1%; font-size:14px; line-height:2em;}
ul.code_list li p{ clear:both;}
ul.code_list li p span{ margin:0 1.5em;}
ul.code_list li div{ clear:both; text-align:right; padding-top:10px; font-size:12px;}
ul.code_list li div dl{ vertical-align:middle; float:right; background:#f7fbff; line-height:20px; padding:10px 15px; height:20px;}
ul.code_list li div dt,ul.code_list li div dd{ float:left;}
ul.code_list li input{ vertical-align:middle;}
ul.code_list li dd label{ margin:0 15px; font-size:15px; font-weight:bold;}
/*文字*/
dl.code_text{ clear:both; width:93%; margin:10px auto;}
dl.code_text dt{ clear:both; font-size:14px; font-weight:bold; line-height:2em;}
dl.code_text dt p{ clear:both; padding-top:10px;}
dl.code_text dd{ clear:both; font-size:14px; line-height:2em;}
dl.code_text dd p{ clear:both;}

/*-----------------------------------star文字的样式*/
/*标题文字*/
.th{ font-family:"Microsoft YaHei";}
/*14号文字*/
.font_14{ font-size:14px;}
/*日期*/
.date{ float:right; color:#999; font-size:12px; font-weight:normal;}
/*左右对齐*/
.l{ float:left;}
.r{ float:right;}
/*宋体*/
.china{ font-family:"宋体";}
/*橘红*/
.orange_text,.orange_link a,.orange_a{ color:#ff6600;}
.ornage_link a:hover{ color:#cc0000;}
/*蓝色*/
.blue_link a,.blue_link_line a{ color:#0c5fa1;}
.blue_link_line a{ text-decoration:underline;}
.blue_link_line a:hover{ text-decoration:none;}
.blue_link a:hover,.blue_link_line a:hover{ color:#ff6600;}
/*红字*/
.red_link a,.red_text{ color:#cc0000;}
.red_link a:hover{ color:#ff6600;}
/*----------star图片的样式*/
.img_border img{ border:2px solid #eee; background:#fff; overflow:hidden;}
.img_border a:hover img{ border:2px solid #ccc;}
/*---------------------------star滤镜的样式*/
/*阴影*/
.white_box{ background:#fff; border:1px solid #d4dbe1; _position:relative;
-moz-box-shadow:2px 2px 3px #e5eaf0; -webkit-box-shadow:2px 2px 3px #e5eaf0; box-shadow:2px 2px 3px #e5eaf0;}
/*圆角*/
.round_btn{_position:relative;text-align:center; vertical-align:middle; border:none; cursor:pointer;
-moz-border-radius:4px; -webkit-border-radius:4px; border-radius:4px; }
.input_round{_position:relative;-moz-border-radius:4px; -webkit-border-radius:4px; border-radius:4px;}
dl.code_list dd li div{-moz-border-radius:4px; -webkit-border-radius:4px; border-radius:4px;}
span.e_num a{_position:relative;
-moz-border-radius:15px; -webkit-border-radius:15px; border-radius:15px; }
/*文件链接*/
.white_box,.round_btn,dl.code_list dd li div,.input_round{behavior: url(pie.htc);}

 

/*上级地域*/
ul.ztree {margin-top: 10px;border: 1px solid #617775;background: #f0f6e4;width:220px;height:120px;overflow-y:scroll;overflow-x:auto;}
ul.log {border: 1px solid #617775;background: #f0f6e4;width:300px;height:170px;overflow: hidden;}
ul.log.small {height:45px;}
ul.log li {color: #666666;list-style: none;padding-left: 10px;}
ul.log li.dark {background-color: #E3E3E3;}