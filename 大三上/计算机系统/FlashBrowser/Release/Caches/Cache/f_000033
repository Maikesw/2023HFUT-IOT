<script type="text/javascript">
    $(document).ready(function(){
        $('#checkCodeImage').click(function () {//生成验证码
            $(this).hide().attr('src', 'http://114.213.210.2:8080/JPKC-OS/manage/checkCode.shtml?' + Math.floor(Math.random()*100) ).fadeIn();
        });
    });
    function onLogin(){
    	//登录
        var userName = $("#userNameLogin").val();
        var userPass = $("#userPassLogin").val();
        var checkCode = $("#checkCode").val();
        
        if(userName == ""){
            alert("帐号不能为空！");
            $("#userNameLogin").focus();
        }else if(userPass == ""){
            alert("密码不能为空！");
            $("#userPassLogin").focus();
        }else if(checkCode == ""){
        	alert("验证码不能为空！");
        	$("#checkCode").focus();
        }else{
            $.ajax({
                url:"login.shtml",
                data:{userName:userName,userPass:userPass,checkCode:checkCode},
                type:"POST",
                contentType:"application/x-www-form-urlencoded;charset=utf-8",
                dataType:"json",
                async:false,
                error:function(x,e){
                    window.location.reload();
                },
                success:function(data){
                    if(data.checkCode){
                    	$.cookie('userNameLogin', userName , { path: '/', expires: 30});
                    	$.cookie('userPassLogin', '' , { path: '/', expires: 30});
                    	if(!data.userName || !data.userPass){
                    		alert("帐号或密码不正确！");
                    	}else{
                    		if(!data.isEnable){
                    			alert("用户已过期！");
                    			$.cookie('userNameLogin', '' , { path: '/', expires: 30});
                    			$.cookie('userPassLogin', '' , { path: '/', expires: 30});
                    		}else{
                    			$.cookie('userNameLogin', userName , { path: '/', expires: 30});
                    			$.cookie('userPassLogin', userPass , { path: '/', expires: 30});
                    		}
                    	}
                    }else{
                    	alert("验证码不正确！");
                    	if(data.userName){
                    		$.cookie('userNameLogin', userName , { path: '/', expires: 30});
                    		if(data.userPass){
                        		$.cookie('userPassLogin', userPass , { path: '/', expires: 30});
                        	}else{
                        		$.cookie('userPassLogin', '' , { path: '/', expires: 30});
                        	}
                    	}else{
                   			$.cookie('userNameLogin', '' , { path: '/', expires: 30});
                       		$.cookie('userPassLogin', '' , { path: '/', expires: 30});
                    	}
                    }
                    window.location.reload();
                }
            });
        }
    }
    function use(){
       	document.getElementById("win").style.display="";
    }
    function closeLogin(){
 	 	document.getElementById("win").style.display="none";
   	}
    function saveUser(){
    	if($("#userTrueName").val()==""){
    		alert("真实姓名不能为空！");
    	}else if($("#userPass").val()==""){
    		alert("密码不能为空！");
    	}else{
    		document.saveForm.submit();
    	}
    }
    function EnterKeyUp(e) {
        var code = e.keyCode;
        if (code == "13") {
            var obj = null;
            if (window.event) {
                obj = document.activeElement;
            } else {
                obj = e.explicitOriginalTarget;
            }
            if (obj == null)
                return;
            onLogin();   // 提交方法
        } 
    } 
