		icos.eq(i).addClass(on);
		imgs.hide().eq(i).show();
		as.hide().eq(i).show();
	}
	icos.mouseover(function(){
		j = icos.index($(this));
		tab();
		window.clearInterval(si);
	}).mouseout(function(){
