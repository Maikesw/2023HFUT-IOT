				for (var a=0;a<selectAllId.length ;a++ ){   
					var isWhere = 0;
					$("#infoTable>tbody").find("input:checked").each(function(i){
	                     var selectRow = $(this).parent().parent();
	                     if(selectAllId[a] == selectRow.find("td").eq(1).text()){
	                     	isWhere = 1;
	                     }
	                 });
