	function buildTable(data){
        var tempHtml ="";
        if(data.listInfo.length==0){
            tempHtml ="<tr align=\"center\" bgcolor=\"#FFFFFF\"><td colspan=\"25\" style=\"color:red;\">查询无数据</td></tr>";
        }
        var index = 0;
        for(var i=0;i<data.listInfo.length;i++){
        
        	tempHtml += "<tr bgcolor=\"#FFFFFF\">"+
                "<td align=\"left\">"+"<input type=\"checkbox\" class=\"chbox\"/></td>"+
                "<td style=\"display:none;\">"+data.listInfo[i].id+"</td>"+
                "<td align=\"left\">"+ data.listInfo[i].userName + "</td>"+
                "<td align=\"left\">" + data.listInfo[i].userTrueName + "</td>"+
                "<td align=\"left\">" +data.listInfo[i].userSex+"</td>"+
                "</tr>";
        }
        $("#infoTable>tbody").html(tempHtml);
