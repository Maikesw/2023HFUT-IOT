# ==================== 单步调试配置 ====================
# clk连接到P15（RST按钮引脚），按一次按钮产生一个时钟周期，实现单步执行
set_property CLOCK_DEDICATED_ROUTE FALSE [get_nets clk]
set_property IOSTANDARD LVCMOS33 [get_ports clk]
set_property PACKAGE_PIN P15 [get_ports clk]

set_property IOSTANDARD LVCMOS33 [get_ports clk0]


set_property PACKAGE_PIN P17 [get_ports clk0]

# ==================== 调试配置说明 ====================
# 如果需要使用ILA调试，请通过Vivado的调试向导配置：
# 1. 在Flow Navigator中选择 "Settings -> Synthesis -> Options"
#    勾选 "-flatten_hierarchy none" 或 "rebuilt"
# 2. 在 "Settings -> Implementation -> Options"
#    勾选 "Enable debug cores"
# 3. 运行综合后，使用 "Tools -> Set Up Debug" 向导来配置ILA
# 这样可以自动生成正确的调试约束，避免手动配置错误
# ====================

# pcAddr信号的终端设置（用于减少信号反射）
